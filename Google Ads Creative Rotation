// =========================================================
// GOOGLE ADS STATE
// =========================================================

function collectCreativeAssetState() {

  var query =
    "SELECT " +
    "campaign.name, " +
    "ad_group.name, " +
    "ad_group_ad.ad.id, " +
    "ad_group_ad_asset_view.field_type, " +
    "ad_group_ad_asset_view.performance_label, " +
    "asset.text_asset.text " +

    "FROM ad_group_ad_asset_view " +

    "WHERE " +
    "campaign.status = 'ENABLED' " +
    "AND ad_group.status = 'ENABLED' " +
    "AND campaign.advertising_channel_type = 'MULTI_CHANNEL' " +
    "AND ad_group_ad_asset_view.field_type IN ('HEADLINE', 'DESCRIPTION')";


  var report =
    AdsApp.search(
      query
    );


  var statusByText = {};


  var currentCampaignTextSet =
    new Set();


  var lowAssets = [];


  while (
    report.hasNext()
  ) {

    var row =
      report.next();


    var campaignName =
      row.campaign.name;


    var adGroupName =
      row.adGroup.name;


    var adId =
      String(
        row.adGroupAd.ad.id ||
        ''
      );


    var assetType =
      row
        .adGroupAdAssetView
        .fieldType;


    var textValue =
      row
        .asset
        .textAsset
        .text;


    var performanceLabel =
      String(
        row
          .adGroupAdAssetView
          .performanceLabel ||
        ''
      )
        .trim()
        .toUpperCase();


    if (
      !textValue
    ) {

      continue;
    }


    // =====================================================
    // CURRENT CAMPAIGN TEXTS
    // =====================================================

    currentCampaignTextSet.add(
      buildCampaignTextKey(
        campaignName,
        assetType,
        textValue
      )
    );


    // =====================================================
    // PERFORMANCE STATUS
    // =====================================================

    var globalTextKey =
      buildGlobalTextStatusKey(
        assetType,
        textValue
      );


    if (
      !statusByText[
        globalTextKey
      ]
    ) {

      statusByText[
        globalTextKey
      ] = {
        hasLow: false,
        hasBest: false
      };
    }


    if (
      performanceLabel ===
      'LOW'
    ) {

      statusByText[
        globalTextKey
      ].hasLow =
        true;


      lowAssets.push({

        campaignName:
          campaignName,

        adGroupName:
          adGroupName,

        adId:
          adId,

        assetType:
          assetType,

        text:
          textValue
      });
    }


    if (
      performanceLabel ===
      'BEST'
    ) {

      statusByText[
        globalTextKey
      ].hasBest =
        true;
    }
  }


  return {

    statusByText:
      statusByText,

    currentCampaignTextSet:
      currentCampaignTextSet,

    lowAssets:
      lowAssets
  };
}


// =========================================================
// KEYS
// =========================================================

function buildGlobalTextStatusKey(
  assetType,
  textValue
) {

  return (
    String(
      assetType ||
      ''
    )
      .trim()
      .toUpperCase() +

    '_' +

    normalizeComparableText(
      textValue
    )
  );
}


function buildCampaignTextKey(
  campaignName,
  assetType,
  textValue
) {

  return (
    String(
      campaignName ||
      ''
    )
      .trim() +

    '_' +

    String(
      assetType ||
      ''
    )
      .trim()
      .toUpperCase() +

    '_' +

    normalizeComparableText(
      textValue
    )
  );
}


// =========================================================
// COLORS
// =========================================================

function applyPerformanceColorsToAllPools(
  spreadsheet,
  statusByText,
  historyLowCountByText
) {

  var totalChanged = 0;
  var totalRed = 0;
  var totalGreen = 0;
  var totalYellow = 0;
  var totalNeutral = 0;


  for (
    var t = 0;
    t < TITLES.length;
    t++
  ) {

    for (
      var langCode in LANGUAGES
    ) {

      var sheetName =
        TITLES[t] +
        ' ' +
        langCode;


      var sheetPool =
        spreadsheet.getSheetByName(
          sheetName
        );


      if (
        !sheetPool
      ) {

        continue;
      }


      var result =
        applyPerformanceColorsToPoolSheet(
          sheetPool,
          statusByText,
          historyLowCountByText
        );


      totalChanged +=
        result.changed;


      totalRed +=
        result.red;


      totalGreen +=
        result.green;


      totalYellow +=
        result.yellow;


      totalNeutral +=
        result.neutral;
    }
  }


  SpreadsheetApp.flush();


  Logger.log(
    'Маркировка: changed=' +
    totalChanged +
    ', RED=' +
    totalRed +
    ', GREEN=' +
    totalGreen +
    ', YELLOW=' +
    totalYellow +
    ', NEUTRAL=' +
    totalNeutral
  );
}


function applyPerformanceColorsToPoolSheet(
  sheetPool,
  statusByText,
  historyLowCountByText
) {

  var range =
    sheetPool.getDataRange();


  var poolData =
    range.getValues();


  var backgrounds =
    range.getBackgrounds();


  var columnMeta = {};


  var counters = {
    changed: 0,
    red: 0,
    green: 0,
    yellow: 0,
    neutral: 0
  };


  if (
    poolData.length === 0
  ) {

    return counters;
  }


  var rowsToScan =
    Math.min(
      poolData.length,
      HEADER_SCAN_ROWS
    );


  for (
    var r = 0;
    r < rowsToScan;
    r++
  ) {

    for (
      var c = 0;
      c < poolData[r].length;
      c++
    ) {

      var assetType =
        parseAssetType(
          poolData[r][c]
        );


      if (
        assetType
      ) {

        columnMeta[c] = {

          assetType:
            assetType,

          dataStartRow:
            r + 1
        };
      }
    }
  }


  var colorsChanged =
    false;


  for (
    var colIndex in columnMeta
  ) {

    var meta =
      columnMeta[
        colIndex
      ];


    var numericColIndex =
      parseInt(
        colIndex,
        10
      );


    for (
      var rowIndex =
        meta.dataStartRow;

      rowIndex <
        poolData.length;

      rowIndex++
    ) {

      var rawValue =
        poolData[
          rowIndex
        ][
          numericColIndex
        ];


      var textValue =
        rawValue
          ? rawValue
              .toString()
              .trim()
          : '';


      if (
        !textValue
      ) {

        continue;
      }


      var statusKey =
        buildGlobalTextStatusKey(
          meta.assetType,
          textValue
        );


      var status =
        statusByText[
          statusKey
        ] || {
          hasLow: false,
          hasBest: false
        };


      var normalizedText =
        normalizeComparableText(
          textValue
        );


      /*
       * Global LOW count.
       */
      var historyLowCount =
        historyLowCountByText[
          normalizedText
        ] ||
        0;


      var oldColor =
        normalizeBackgroundColor(
          backgrounds[
            rowIndex
          ][
            numericColIndex
          ]
        );


      var oldClass =
        getPerformanceColorClass(
          oldColor
        );


      /*
       * Старый GREEN или YELLOW
       * сохраняет исторический BEST signal.
       */
      var hasHistoricalBest =
        oldClass ===
          'GREEN' ||
        oldClass ===
          'YELLOW';


      var hasBestEvidence =
        status.hasBest ||
        hasHistoricalBest;


      /*
       * LOW signal:
       * либо есть History,
       * либо прямо сейчас Google Ads = LOW.
       */
      var hasLowEvidence =
        historyLowCount > 0 ||
        status.hasLow;


      var newClass =
        'NEUTRAL';


      // ---------------------------------------------------
      // BEST + LOW = YELLOW
      // ---------------------------------------------------

      if (
        hasBestEvidence &&
        hasLowEvidence
      ) {

        newClass =
          'YELLOW';


      // ---------------------------------------------------
      // 3+ LOW, BEST нет = RED
      // ---------------------------------------------------

      } else if (
        !hasBestEvidence &&
        historyLowCount >=
          LOW_HISTORY_RED_THRESHOLD
      ) {

        newClass =
          'RED';


      // ---------------------------------------------------
      // BEST without LOW = GREEN
      // ---------------------------------------------------

      } else if (
        hasBestEvidence
      ) {

        newClass =
          'GREEN';


      // ---------------------------------------------------
      // 0-2 LOW without BEST = NEUTRAL
      // ---------------------------------------------------

      } else {

        newClass =
          'NEUTRAL';
      }


      var newColor =
        getColorForPerformanceClass(
          newClass
        );


      if (
        normalizeBackgroundColor(
          newColor
        ) !==
        normalizeBackgroundColor(
          oldColor
        )
      ) {

        backgrounds[
          rowIndex
        ][
          numericColIndex
        ] =
          newColor;


        counters.changed++;


        colorsChanged =
          true;
      }


      if (
        newClass ===
        'RED'
      ) {

        counters.red++;

      } else if (
        newClass ===
        'GREEN'
      ) {

        counters.green++;

      } else if (
        newClass ===
        'YELLOW'
      ) {

        counters.yellow++;

      } else {

        counters.neutral++;
      }
    }
  }


  if (
    colorsChanged
  ) {

    range.setBackgrounds(
      backgrounds
    );
  }


  return counters;
}


// =========================================================
// COLOR -> HEX
// =========================================================

function getColorForPerformanceClass(
  performanceClass
) {

  if (
    performanceClass ===
    'RED'
  ) {

    return LOW_PERFORMANCE_COLOR;
  }


  if (
    performanceClass ===
    'GREEN'
  ) {

    return BEST_PERFORMANCE_COLOR;
  }


  if (
    performanceClass ===
    'YELLOW'
  ) {

    return MIXED_PERFORMANCE_COLOR;
  }


  return NEUTRAL_COLOR;
}


// =========================================================
// SHEET HELPERS
