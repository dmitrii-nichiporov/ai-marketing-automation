// =========================================================
// MAIN
// =========================================================

function main() {

  var spreadsheet =
    SpreadsheetApp.openByUrl(
      SPREADSHEET_URL
    );


  var sheetLow =
    getOrCreateSheet(
      spreadsheet,
      TAB_LOW,
      []
    );


  var sheetHistory =
    getOrCreateSheet(
      spreadsheet,
      TAB_HISTORY,
      [
        'Campaign',
        'Ad Group',
        'Asset Type',
        'Text',
        'Date Removed'
      ]
    );


  var sheetAudit =
    getOrCreateSheet(
      spreadsheet,
      TAB_REPLACEMENT_AUDIT,
      []
    );


  // =======================================================
  // PREPARE LOWPERFORMANCE
  // =======================================================

  prepareLowPerformanceSheet(
    sheetLow
  );


  // =======================================================
  // PREPARE AUDIT
  // =======================================================

  prepareReplacementAuditSheet(
    sheetAudit
  );


  var auditRows = [];


  // =======================================================
  // HISTORY
  // =======================================================

  var historyState =
    buildHistoryState(
      sheetHistory
    );


  // =======================================================
  // GOOGLE ADS STATE
  // =======================================================

  var creativeState =
    collectCreativeAssetState();


  // =======================================================
  // СНАЧАЛА ПЕРЕСЧИТЫВАЕМ ЦВЕТА
  // =======================================================

  applyPerformanceColorsToAllPools(
    spreadsheet,
    creativeState.statusByText,
    historyState.lowCountByText
  );


  SpreadsheetApp.flush();


  // =======================================================
  // ПОСЛЕ ЦВЕТОВ ЧИТАЕМ ПУЛЫ
  // =======================================================

  var allPools = {};
  var allPoolItems = {};


  for (
    var t = 0;
    t < TITLES.length;
    t++
  ) {

    for (
      var langCode in LANGUAGES
    ) {

      var titleName =
        TITLES[t];


      var tabName =
        titleName +
        ' ' +
        langCode;


      var sheetPool =
        spreadsheet.getSheetByName(
          tabName
        );


      if (
        !sheetPool
      ) {

        Logger.log(
          'ПРЕДУПРЕЖДЕНИЕ: вкладка ' +
          tabName +
          ' не найдена.'
        );

        continue;
      }


      var parsedPool =
        parseTextPoolSheet(
          sheetPool
        );


      var poolKey =
        titleName +
        '_' +
        langCode;


      allPools[
        poolKey
      ] =
        parsedPool.candidateItems;


      allPoolItems[
        poolKey
      ] =
        parsedPool.allItems;


      Logger.log(
        '[' +
        tabName +
        '] доступно=' +
        parsedPool.candidateItems.length +
        ', всего=' +
        parsedPool.allItems.length +
        ', RED=' +
        parsedPool.redItemsCount
      );
    }
  }


  // =======================================================
  // LOW ASSETS
  // =======================================================

  var lowAssets =
    creativeState.lowAssets;


  var rowsLow = [];


  // =======================================================
  // MIX CONTROLLER
  // =======================================================

  var mixController =
    createReplacementMixController(
      lowAssets.length,
      historyState.replacementClassCounts
    );


  /*
   * Не допускаем duplicate
   * внутри одной Campaign.
   */
  var reservedTextSet =
    new Set();


  /*
   * Один replacement максимум x3
   * за весь текущий run.
   */
  var replacementUsageCount = {};


  // =======================================================
  // LOW LOOP
  // =======================================================

  for (
    var lowIndex = 0;
    lowIndex < lowAssets.length;
    lowIndex++
  ) {

    var lowAsset =
      lowAssets[
        lowIndex
      ];


    var campaignName =
      lowAsset.campaignName;


    var adGroupName =
      lowAsset.adGroupName;


    var adId =
      lowAsset.adId;


    var assetType =
      lowAsset.assetType;


    var textValue =
      lowAsset.text;


    var upperCampaignName =
      String(
        campaignName ||
        ''
      ).toUpperCase();


    var upperAdGroupName =
      String(
        adGroupName ||
        ''
      ).toUpperCase();


    // =====================================================
    // 1. GAME
    // =====================================================

    var assetTitle =
      DEFAULT_TITLE;


    if (
      upperAdGroupName.indexOf(
        'WW2'
      ) !== -1 ||
      upperCampaignName.indexOf(
        'WW2'
      ) !== -1
    ) {

      assetTitle =
        'WW2';

    } else if (
      upperAdGroupName.indexOf(
        'MOPS'
      ) !== -1 ||
      upperCampaignName.indexOf(
        'MOPS'
      ) !== -1
    ) {

      assetTitle =
        'MOPS';

    } else if (
      upperAdGroupName.indexOf(
        'TOPS'
      ) !== -1 ||
      upperCampaignName.indexOf(
        'TOPS'
      ) !== -1
    ) {

      assetTitle =
        'TOPS';

    } else if (
      upperAdGroupName.indexOf(
        'BFH'
      ) !== -1 ||
      upperCampaignName.indexOf(
        'BFH'
      ) !== -1
    ) {

      assetTitle =
        'BFH';
    }


    // =====================================================
    // 2. LANGUAGE
    // =====================================================

    var campaignLangCode =
      findLanguageByMarkers(
        adGroupName
      );


    if (
      !campaignLangCode
    ) {

      campaignLangCode =
        findLanguageByMarkers(
          campaignName
        );
    }


    if (
      !campaignLangCode
    ) {

      campaignLangCode =
        'ENG';
    }


    // =====================================================
    // 3. POOL
    // =====================================================

    var combinedKey =
      assetTitle +
      '_' +
      campaignLangCode;


    var availablePool =
      allPools[
        combinedKey
      ] ||
      [];


    var lookupPool =
      allPoolItems[
        combinedKey
      ] ||
      [];


    // =====================================================
    // 4. CATEGORY
    // =====================================================

    var targetTheme =
      findThemeForExistingText(
        lookupPool,
        assetType,
        textValue
      );


    if (
      !targetTheme
    ) {

      targetTheme =
        DEFAULT_THEME;
    }


    // =====================================================
    // 4.1 SPECIAL CS / SNIPER
    // =====================================================

    var specialTheme =
      getSpecialReplacementTheme(
        adGroupName
      );


    if (
      specialTheme
    ) {

      targetTheme =
        specialTheme;
    }


    // =====================================================
    // 5. REAL AVAILABILITY
    // =====================================================

    var availability =
      countEligibleReplacementCandidates(
        availablePool,
        assetType,
        targetTheme,
        campaignName,
        textValue,
        historyState.campaignBlacklistSet,
        reservedTextSet,
        creativeState.currentCampaignTextSet,
        replacementUsageCount
      );


    // =====================================================
    // 5.1 CLASS ORDER ONLY AMONG AVAILABLE CLASSES
    // =====================================================

    var classOrder =
      getPreferredAvailableClassOrder(
        mixController,
        availability
      );


    var preferredClass =
      classOrder.length > 0
        ? classOrder[0]
        : '';


    // =====================================================
    // 6. FIND REPLACEMENT
    // =====================================================

    var replacement =
      findReplacementTextByClassOrder(
        availablePool,
        assetType,
        targetTheme,
        campaignName,
        textValue,
        classOrder,
        historyState.campaignBlacklistSet,
        reservedTextSet,
        creativeState.currentCampaignTextSet,
        replacementUsageCount
      );


    // =====================================================
    // 6.1 AUDIT
    // =====================================================

    var selectedClass =
      replacement.performanceClass ||
      '';


    var selectedText =
      replacement.text ||
      '';


    var fallbackUsed =
      (
        selectedClass &&
        preferredClass &&
        selectedClass !==
          preferredClass
      )
        ? 'YES'
        : 'NO';


    var noReplacement =
      selectedText
        ? 'NO'
        : 'YES';


    auditRows.push([
      campaignName,
      adGroupName,
      assetTitle,
      campaignLangCode,
      assetType,
      targetTheme,
      textValue,
      preferredClass,
      availability.GREEN,
      availability.NEUTRAL,
      availability.YELLOW,
      selectedClass,
      selectedText,
      fallbackUsed,
      noReplacement
    ]);


    // =====================================================
    // 7. REGISTER REPLACEMENT
    // =====================================================

    if (
      replacement.text
    ) {

      registerReplacementClass(
        mixController,
        replacement.performanceClass
      );


      incrementReplacementUsage(
        replacementUsageCount,
        replacement.text
      );
    }


    rowsLow.push([
      campaignName,
      adGroupName,
      assetType,
      textValue,
      replacement.text || '',
      false,
      adId,
      replacement.performanceClass || ''
    ]);


    /*
     * Старый LOW не может
     * заменить сам себя.
     */
    reservedTextSet.add(
      buildCampaignTextKey(
        campaignName,
        assetType,
        textValue
      )
    );
  }


  // =======================================================
  // WRITE LOWPERFORMANCE
  // =======================================================

  if (
    rowsLow.length > 0
  ) {

    sheetLow
      .getRange(
        LOW_DATA_START_ROW,
        1,
        rowsLow.length,
        8
      )
      .setValues(
        rowsLow
      );


    /*
     * Checkboxes Approve.
     */
    sheetLow
      .getRange(
        LOW_DATA_START_ROW,
        6,
        rowsLow.length,
        1
      )
      .insertCheckboxes();


    /*
     * G = Ad ID
     * H = Replacement Class
     */
    sheetLow.hideColumns(
      7,
      2
    );


    Logger.log(
      'LOW текстов: ' +
      rowsLow.length
    );

  } else {

    Logger.log(
      'LOW текстов не найдено.'
    );
  }


  // =======================================================
  // WRITE AUDIT
  // =======================================================

  if (
    auditRows.length > 0
  ) {

    sheetAudit
      .getRange(
        2,
        1,
        auditRows.length,
        15
      )
      .setValues(
        auditRows
      );


    sheetAudit.setFrozenRows(
      1
    );


    sheetAudit.autoResizeColumns(
      1,
      15
    );
  }


  var auditSummary =
    buildReplacementAuditSummary(
      auditRows
    );


  var summaryStartRow =
    auditRows.length +
    4;


  sheetAudit
    .getRange(
      summaryStartRow,
      1,
      auditSummary.length,
      auditSummary[0].length
    )
    .setValues(
      auditSummary
    );


  /*
   * Target %
   * Actually selected %
   */
  sheetAudit
    .getRange(
      summaryStartRow + 5,
      2,
      2,
      3
    )
    .setNumberFormat(
      '0.0%'
    );


  Logger.log(
    'Current run: GREEN=' +
    mixController.assigned.GREEN +
    ', NEUTRAL=' +
    mixController.assigned.NEUTRAL +
    ', YELLOW=' +
    mixController.assigned.YELLOW +
    ' | History: GREEN=' +
    mixController.history.GREEN +
    ', NEUTRAL=' +
    mixController.history.NEUTRAL +
    ', YELLOW=' +
    mixController.history.YELLOW
  );


  // =======================================================
  // EDITOR SOURCE
  // =======================================================

  refreshEditorSource(
    spreadsheet
  );
}


