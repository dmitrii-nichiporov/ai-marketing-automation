// =========================================================
// HISTORY STATE
// =========================================================

function buildHistoryState(
  sheetHistory
) {

  var data =
    sheetHistory
      .getDataRange()
      .getValues();


  /*
   * Global LOW count by Text.
   */
  var lowCountByText = {};


  /*
   * Campaign-specific blacklist
   * используется только
   * для NEUTRAL candidates.
   */
  var campaignBlacklistSet =
    new Set();


  /*
   * Реально примененные replacement classes.
   */
  var replacementClassCounts = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  if (
    data.length === 0
  ) {

    return {
      lowCountByText:
        lowCountByText,

      campaignBlacklistSet:
        campaignBlacklistSet,

      replacementClassCounts:
        replacementClassCounts
    };
  }


  var headers =
    data[0];


  var replacementClassCol =
    findHeaderIndex(
      headers,
      'Replacement Class'
    );


  for (
    var i = 1;
    i < data.length;
    i++
  ) {

    var campaign =
      data[i][0];


    var assetType =
      data[i][2];


    var oldText =
      data[i][3];


    // =====================================================
    // GLOBAL LOW COUNT
    // =====================================================

    if (
      oldText &&
      normalizeComparableText(
        oldText
      )
    ) {

      var normalizedText =
        normalizeComparableText(
          oldText
        );


      /*
       * Каждая строка History =
       * одно подтвержденное LOW событие.
       */
      lowCountByText[
        normalizedText
      ] =
        (
          lowCountByText[
            normalizedText
          ] ||
          0
        ) +
        1;


      /*
       * Для NEUTRAL отдельно помним,
       * где текст уже был LOW.
       */
      campaignBlacklistSet.add(
        buildCampaignTextKey(
          campaign,
          assetType,
          oldText
        )
      );
    }


    // =====================================================
    // REPLACEMENT CLASS HISTORY
    // =====================================================

    if (
      replacementClassCol >= 0
    ) {

      var replacementClass =
        String(
          data[i][
            replacementClassCol
          ] ||
          ''
        )
          .trim()
          .toUpperCase();


      if (
        replacementClassCounts
          .hasOwnProperty(
            replacementClass
          )
      ) {

        replacementClassCounts[
          replacementClass
        ]++;
      }
    }
  }


  return {
    lowCountByText:
      lowCountByText,

    campaignBlacklistSet:
      campaignBlacklistSet,

    replacementClassCounts:
      replacementClassCounts
  };
}


// =========================================================
// HEADER
// =========================================================

function findHeaderIndex(
  headers,
  targetName
) {

  var target =
    String(
      targetName ||
      ''
    )
      .trim()
      .toLowerCase();


  for (
    var i = 0;
    i < headers.length;
    i++
  ) {

    if (
      String(
        headers[i] ||
        ''
      )
        .trim()
        .toLowerCase() ===
      target
    ) {

      return i;
    }
  }


  return -1;
}


// =========================================================
// MIX CONTROLLER
// =========================================================

function createReplacementMixController(
  runSize,
  historyCounts
) {

  var baseQuota =
    allocateIntegerQuotas(
      runSize,
      REPLACEMENT_TARGETS
    );


  var margin =
    Math.max(
      1,
      Math.round(
        runSize *
        HISTORY_CORRECTION_MARGIN
      )
    );


  var minQuota = {};
  var maxQuota = {};


  for (
    var i = 0;
    i < REPLACEMENT_CLASSES.length;
    i++
  ) {

    var cls =
      REPLACEMENT_CLASSES[i];


    minQuota[
      cls
    ] =
      Math.max(
        0,
        baseQuota[
          cls
        ] -
        margin
      );


    maxQuota[
      cls
    ] =
      Math.min(
        runSize,
        baseQuota[
          cls
        ] +
        margin
      );
  }


  return {

    runSize:
      runSize,

    baseQuota:
      baseQuota,

    minQuota:
      minQuota,

    maxQuota:
      maxQuota,

    assigned: {
      GREEN: 0,
      NEUTRAL: 0,
      YELLOW: 0
    },

    history: {
      GREEN:
        historyCounts.GREEN ||
        0,

      NEUTRAL:
        historyCounts.NEUTRAL ||
        0,

      YELLOW:
        historyCounts.YELLOW ||
        0
    }
  };
}


// =========================================================
// INTEGER QUOTAS
// =========================================================

function allocateIntegerQuotas(
  total,
  targets
) {

  var quotas = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  var fractions = [];
  var used = 0;


  for (
    var i = 0;
    i < REPLACEMENT_CLASSES.length;
    i++
  ) {

    var cls =
      REPLACEMENT_CLASSES[i];


    var exact =
      total *
      targets[
        cls
      ];


    var base =
      Math.floor(
        exact
      );


    quotas[
      cls
    ] =
      base;


    used +=
      base;


    fractions.push({
      cls:
        cls,

      fraction:
        exact -
        base
    });
  }


  fractions.sort(
    function(a, b) {

      return (
        b.fraction -
        a.fraction
      );
    }
  );


  var remaining =
    total -
    used;


  for (
    var r = 0;
    r < remaining;
    r++
  ) {

    quotas[
      fractions[
        r %
        fractions.length
      ].cls
    ]++;
  }


  return quotas;
}


// =========================================================
// AVAILABILITY-AWARE CLASS ORDER
// =========================================================

function getPreferredAvailableClassOrder(
  controller,
  availability
) {

  /*
   * В расчёт попадают только классы,
   * где прямо сейчас есть
   * хотя бы один candidate.
   */
  var availableClasses = [];


  for (
    var i = 0;
    i < REPLACEMENT_CLASSES.length;
    i++
  ) {

    var cls =
      REPLACEMENT_CLASSES[i];


    if (
      (
        availability[
          cls
        ] ||
        0
      ) > 0
    ) {

      availableClasses.push(
        cls
      );
    }
  }


  if (
    availableClasses.length === 0
  ) {

    return [];
  }


  var assignedTotal =
    controller.assigned.GREEN +
    controller.assigned.NEUTRAL +
    controller.assigned.YELLOW;


  var historyTotal =
    controller.history.GREEN +
    controller.history.NEUTRAL +
    controller.history.YELLOW;


  var scored = [];


  for (
    var j = 0;
    j < availableClasses.length;
    j++
  ) {

    var currentClass =
      availableClasses[j];


    /*
     * Насколько этот класс недобран
     * в общей истории.
     */
    var totalAfterNext =
      historyTotal +
      assignedTotal +
      1;


    var expectedAfterNext =
      totalAfterNext *
      REPLACEMENT_TARGETS[
        currentClass
      ];


    var actualBeforeNext =
      controller.history[
        currentClass
      ] +
      controller.assigned[
        currentClass
      ];


    var deficit =
      expectedAfterNext -
      actualBeforeNext;


    /*
     * Насколько класс недобран
     * именно в текущем run.
     */
    var expectedCurrentRun =
      (
        assignedTotal +
        1
      ) *
      REPLACEMENT_TARGETS[
        currentClass
      ];


    var currentRunDeficit =
      expectedCurrentRun -
      controller.assigned[
        currentClass
      ];


    /*
     * Если возможность использовать класс редкая,
     * даём маленький bonus.
     */
    var availabilityBonus =
      1 /
      Math.max(
        1,
        availability[
          currentClass
        ]
      );


    scored.push({

      cls:
        currentClass,

      score:
        deficit +
        (
          currentRunDeficit *
          0.25
        ) +
        (
          availabilityBonus *
          0.05
        )
    });
  }


  scored.sort(
    function(a, b) {

      return (
        b.score -
        a.score
      );
    }
  );


  return scored.map(
    function(item) {

      return item.cls;
    }
  );
}


function registerReplacementClass(
  controller,
  cls
) {

  if (
    controller.assigned
      .hasOwnProperty(
        cls
      )
  ) {

    controller.assigned[
      cls
    ]++;
  }
}


