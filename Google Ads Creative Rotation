// =========================================================
// POOL PARSER
// =========================================================

function parseTextPoolSheet(
  sheetPool
) {

  var range =
    sheetPool.getDataRange();


  var poolData =
    range.getValues();


  var backgrounds =
    range.getBackgrounds();


  var columnMeta = {};


  var allItems = [];
  var candidateItems = [];
  var redItemsCount = 0;


  if (
    poolData.length === 0
  ) {

    return {

      allItems:
        allItems,

      candidateItems:
        candidateItems,

      redItemsCount:
        redItemsCount
    };
  }


  var rowsToScan =
    Math.min(
      poolData.length,
      HEADER_SCAN_ROWS
    );


  for (
    var r = 0;
    r < rowsToScan;
    r++
  ) {

    for (
      var c = 0;
      c < poolData[r].length;
      c++
    ) {

      var assetType =
        parseAssetType(
          poolData[r][c]
        );


      if (
        assetType
      ) {

        columnMeta[c] = {

          assetType:
            assetType,

          theme:
            detectThemeForColumn(
              poolData,
              r,
              c
            ),

          dataStartRow:
            r + 1
        };
      }
    }
  }


  for (
    var colIndex in columnMeta
  ) {

    var meta =
      columnMeta[
        colIndex
      ];


    var numericColIndex =
      parseInt(
        colIndex,
        10
      );


    for (
      var rowIndex =
        meta.dataStartRow;

      rowIndex <
        poolData.length;

      rowIndex++
    ) {

      var rawValue =
        poolData[
          rowIndex
        ][
          numericColIndex
        ];


      var textValueFromPool =
        rawValue
          ? rawValue
              .toString()
              .trim()
          : '';


      if (
        !textValueFromPool
      ) {

        continue;
      }


      var performanceColorClass =
        getPerformanceColorClass(
          backgrounds[
            rowIndex
          ][
            numericColIndex
          ]
        );


      var item = {

        assetType:
          meta.assetType,

        text:
          textValueFromPool,

        theme:
          meta.theme ||
          DEFAULT_THEME,

        themeKey:
          normalizeThemeKey(
            meta.theme ||
            DEFAULT_THEME
          ),

        isRed:
          performanceColorClass ===
          'RED',

        performanceColorClass:
          performanceColorClass,

        row:
          rowIndex + 1,

        column:
          numericColIndex + 1
      };


      allItems.push(
        item
      );


      /*
       * RED никогда не candidate.
       */
      if (
        item.isRed
      ) {

        redItemsCount++;

        continue;
      }


      candidateItems.push(
        item
      );
    }
  }


  return {

    allItems:
      allItems,

    candidateItems:
      candidateItems,

    redItemsCount:
      redItemsCount
  };
}


// =========================================================
// ASSET TYPE
// =========================================================

function parseAssetType(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return null;
  }


  var normalized =
    value
      .toString()
      .trim()
      .toUpperCase()
      .replace(
        /\s+/g,
        ' '
      );


  if (
    normalized ===
      'HEADLINE' ||
    normalized ===
      'HEADLINES'
  ) {

    return 'HEADLINE';
  }


  if (
    normalized ===
      'DESCRIPTION' ||
    normalized ===
      'DESCRIPTIONS'
  ) {

    return 'DESCRIPTION';
  }


  return null;
}


// =========================================================
// CATEGORY
// =========================================================

function detectThemeForColumn(
  poolData,
  headerRowIndex,
  colIndex
) {

  for (
    var r =
      headerRowIndex -
      1;

    r >= 0;

    r--
  ) {

    var directTheme =
      cleanThemeValue(
        poolData[r][
          colIndex
        ]
      );


    if (
      directTheme
    ) {

      return directTheme;
    }


    for (
      var c =
        colIndex;

      c >= 0;

      c--
    ) {

      var leftTheme =
        cleanThemeValue(
          poolData[r][c]
        );


      if (
        leftTheme
      ) {

        return leftTheme;
      }
    }
  }


  return DEFAULT_THEME;
}


function cleanThemeValue(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return null;
  }


  var theme =
    value
      .toString()
      .trim();


  if (
    !theme
  ) {

    return null;
  }


  if (
    parseAssetType(
      theme
    )
  ) {

    return null;
  }


  var upperTheme =
    theme.toUpperCase();


  if (
    upperTheme ===
      'THEME' ||
    upperTheme ===
      'TOPIC' ||
    upperTheme ===
      'TOPICS' ||
    upperTheme ===
      'TEXT' ||
    upperTheme ===
      'TEXTS' ||
    upperTheme ===
      'ASSET TYPE'
  ) {

    return null;
  }


  return theme;
}


// =========================================================
// SPECIAL CATEGORY
// =========================================================

function getSpecialReplacementTheme(
  adGroupName
) {

  var name =
    String(
      adGroupName ||
      ''
    )
      .trim()
      .toLowerCase();


  var hasSniper =
    /(^|[^a-z0-9])sniper([^a-z0-9]|$)/i
      .test(
        name
      );


  var hasCs =
    /(^|[^a-z0-9])cs([^a-z0-9]|$)/i
      .test(
        name
      );


  if (
    hasSniper
  ) {

    return 'sniper cpp';
  }


  if (
    hasCs
  ) {

    return 'cpp cs';
  }


  return null;
}


// =========================================================
// FIND CATEGORY FOR OLD LOW
// =========================================================

function findThemeForExistingText(
  lookupPool,
  assetType,
  textValue
) {

  var normalizedText =
    normalizeComparableText(
      textValue
    );


  for (
    var i = 0;
    i < lookupPool.length;
    i++
  ) {

    var item =
      lookupPool[i];


    if (
      item.assetType !==
      assetType
    ) {

      continue;
    }


    if (
      normalizeComparableText(
        item.text
      ) ===
      normalizedText
    ) {

      return (
        item.theme ||
        DEFAULT_THEME
      );
    }
  }


  return null;
}


// =========================================================
// CATEGORY MATCH
// =========================================================

function doesThemeMatchTarget(
  poolThemeKey,
  targetThemeKey
) {

  if (
    !poolThemeKey ||
    !targetThemeKey
  ) {

    return false;
  }


  if (
    targetThemeKey ===
    'SNIPER CPP'
  ) {

    return (
      poolThemeKey
        .indexOf(
          'SNIPER CPP'
        ) !== -1
    );
  }


  if (
    targetThemeKey ===
    'CPP CS'
  ) {

    return (
      poolThemeKey
        .indexOf(
          'CPP CS'
        ) !== -1
    );
  }


  return (
    poolThemeKey ===
    targetThemeKey
  );
}


// =========================================================
// COUNT REAL AVAILABLE CANDIDATES
// =========================================================

function countEligibleReplacementCandidates(
  availablePool,
  assetType,
  targetTheme,
  campaignName,
  oldTextValue,
  historyBlacklistSet,
  reservedTextSet,
  currentCampaignTextSet,
  replacementUsageCount
) {

  var counts = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  var targetThemeKey =
    normalizeThemeKey(
      targetTheme ||
      DEFAULT_THEME
    );


  var oldTextNormalized =
    normalizeComparableText(
      oldTextValue
    );


  for (
    var i = 0;
    i < availablePool.length;
    i++
  ) {

    var poolItem =
      availablePool[i];


    var candidateClass =
      poolItem
        .performanceColorClass;


    /*
     * RED сюда не попадает.
     */
    if (
      !counts.hasOwnProperty(
        candidateClass
      )
    ) {

      continue;
    }


    // -----------------------------------------------------
    // ASSET TYPE
    // -----------------------------------------------------

    if (
      poolItem.assetType !==
      assetType
    ) {

      continue;
    }


    // -----------------------------------------------------
    // CATEGORY
    // -----------------------------------------------------

    if (
      !doesThemeMatchTarget(
        poolItem.themeKey,
        targetThemeKey
      )
    ) {

      continue;
    }


    // -----------------------------------------------------
    // NOT OLD LOW
    // -----------------------------------------------------

    if (
      normalizeComparableText(
        poolItem.text
      ) ===
      oldTextNormalized
    ) {

      continue;
    }


    // -----------------------------------------------------
    // LENGTH
    // -----------------------------------------------------

    var textLength =
      poolItem.text.length;


    if (
      assetType ===
        'HEADLINE' &&
      textLength > 30
    ) {

      continue;
    }


    if (
      assetType ===
        'DESCRIPTION' &&
      textLength > 90
    ) {

      continue;
    }


    var candidateKey =
      buildCampaignTextKey(
        campaignName,
        assetType,
        poolItem.text
      );


    // -----------------------------------------------------
    // NEUTRAL HISTORY PROTECTION
    // -----------------------------------------------------

    if (
      candidateClass ===
        'NEUTRAL' &&
      historyBlacklistSet &&
      historyBlacklistSet.has(
        candidateKey
      )
    ) {

      continue;
    }


    // -----------------------------------------------------
    // RESERVED IN SAME CAMPAIGN
    // -----------------------------------------------------

    if (
      reservedTextSet &&
      reservedTextSet.has(
        candidateKey
      )
    ) {

      continue;
    }


    // -----------------------------------------------------
    // ALREADY ACTIVE IN CAMPAIGN
    // -----------------------------------------------------

    if (
      currentCampaignTextSet &&
      currentCampaignTextSet.has(
        candidateKey
      )
    ) {

      continue;
    }


    // -----------------------------------------------------
    // MAX x3 THIS RUN
    // -----------------------------------------------------

    var usageKey =
      normalizeComparableText(
        poolItem.text
      );


    if (
      (
        replacementUsageCount[
          usageKey
        ] ||
        0
      ) >=
      MAX_SAME_REPLACEMENT_PER_RUN
    ) {

      continue;
    }


    counts[
      candidateClass
    ]++;
  }


  return counts;
}


// =========================================================
// FIND REPLACEMENT
// =========================================================

function findReplacementTextByClassOrder(
  availablePool,
  assetType,
  targetTheme,
  campaignName,
  oldTextValue,
  classOrder,
  historyBlacklistSet,
  reservedTextSet,
  currentCampaignTextSet,
  replacementUsageCount
) {

  var targetThemeKey =
    normalizeThemeKey(
      targetTheme ||
      DEFAULT_THEME
    );


  var oldTextNormalized =
    normalizeComparableText(
      oldTextValue
    );


  for (
    var orderIndex = 0;
    orderIndex < classOrder.length;
    orderIndex++
  ) {

    var requiredClass =
      classOrder[
        orderIndex
      ];


    var eligibleCandidates = [];


    for (
      var j = 0;
      j < availablePool.length;
      j++
    ) {

      var poolItem =
        availablePool[j];


      // ---------------------------------------------------
      // COLOR
      // ---------------------------------------------------

      if (
        poolItem
          .performanceColorClass !==
        requiredClass
      ) {

        continue;
      }


      // ---------------------------------------------------
      // ASSET TYPE
      // ---------------------------------------------------

      if (
        poolItem.assetType !==
        assetType
      ) {

        continue;
      }


      // ---------------------------------------------------
      // CATEGORY
      // ---------------------------------------------------

      if (
        !doesThemeMatchTarget(
          poolItem.themeKey,
          targetThemeKey
        )
      ) {

        continue;
      }


      // ---------------------------------------------------
      // NOT OLD LOW
      // ---------------------------------------------------

      if (
        normalizeComparableText(
          poolItem.text
        ) ===
        oldTextNormalized
      ) {

        continue;
      }


      // ---------------------------------------------------
      // LENGTH
      // ---------------------------------------------------

      var textLength =
        poolItem.text.length;


      if (
        assetType ===
          'HEADLINE' &&
        textLength > 30
      ) {

        continue;
      }


      if (
        assetType ===
          'DESCRIPTION' &&
        textLength > 90
      ) {

        continue;
      }


      var candidateKey =
        buildCampaignTextKey(
          campaignName,
          assetType,
          poolItem.text
        );


      // ---------------------------------------------------
      // NEUTRAL HISTORY
      // ---------------------------------------------------

      if (
        requiredClass ===
          'NEUTRAL' &&
        historyBlacklistSet &&
        historyBlacklistSet.has(
          candidateKey
        )
      ) {

        continue;
      }


      // ---------------------------------------------------
      // RESERVED
      // ---------------------------------------------------

      if (
        reservedTextSet &&
        reservedTextSet.has(
          candidateKey
        )
      ) {

        continue;
      }


      // ---------------------------------------------------
      // ALREADY ACTIVE
      // ---------------------------------------------------

      if (
        currentCampaignTextSet &&
        currentCampaignTextSet.has(
          candidateKey
        )
      ) {

        continue;
      }


      // ---------------------------------------------------
      // GLOBAL USAGE
      // ---------------------------------------------------

      var globalUsageKey =
        normalizeComparableText(
          poolItem.text
        );


      var usageCount =
        replacementUsageCount[
          globalUsageKey
        ] ||
        0;


      if (
        usageCount >=
        MAX_SAME_REPLACEMENT_PER_RUN
      ) {

        continue;
      }


      eligibleCandidates.push({

        item:
          poolItem,

        usageCount:
          usageCount
      });
    }


    if (
      eligibleCandidates.length === 0
    ) {

      continue;
    }


    // =====================================================
    // LEAST USED FIRST
    // =====================================================

    /*
     * Если есть варианты:
     *
     * A = использован 0
     * B = использован 0
     * C = использован 2
     *
     * random идет только между A/B.
     */
    var minimumUsage =
      eligibleCandidates[0]
        .usageCount;


    for (
      var u = 1;
      u < eligibleCandidates.length;
      u++
    ) {

      if (
        eligibleCandidates[u]
          .usageCount <
        minimumUsage
      ) {

        minimumUsage =
          eligibleCandidates[u]
            .usageCount;
      }
    }


    var leastUsedCandidates = [];


    for (
      var l = 0;
      l < eligibleCandidates.length;
      l++
    ) {

      if (
        eligibleCandidates[l]
          .usageCount ===
        minimumUsage
      ) {

        leastUsedCandidates.push(
          eligibleCandidates[l]
        );
      }
    }


    // =====================================================
    // RANDOM AMONG LEAST USED
    // =====================================================

    var randomPos =
      Math.floor(
        Math.random() *
        leastUsedCandidates.length
      );


    var selected =
      leastUsedCandidates[
        randomPos
      ];


    var selectedItem =
      selected.item;


    var selectedCampaignKey =
      buildCampaignTextKey(
        campaignName,
        assetType,
        selectedItem.text
      );


    if (
      reservedTextSet
    ) {

      reservedTextSet.add(
        selectedCampaignKey
      );
    }


    if (
      currentCampaignTextSet
    ) {

      currentCampaignTextSet.add(
        selectedCampaignKey
      );
    }


    return {

      text:
        selectedItem.text,

      performanceClass:
        selectedItem
          .performanceColorClass
    };
  }


  return {
    text: '',
    performanceClass: ''
  };
}


// =========================================================
// AUDIT SUMMARY
// =========================================================

function buildReplacementAuditSummary(
  auditRows
) {

  var selected = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  var preferred = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  var fallbackFrom = {
    GREEN: 0,
    NEUTRAL: 0,
    YELLOW: 0
  };


  var noReplacement =
    0;


  for (
    var i = 0;
    i < auditRows.length;
    i++
  ) {

    var row =
      auditRows[i];


    var preferredClass =
      row[7];


    var selectedClass =
      row[11];


    var fallbackUsed =
      row[13];


    var noReplacementFlag =
      row[14];


    if (
      preferred.hasOwnProperty(
        preferredClass
      )
    ) {

      preferred[
        preferredClass
      ]++;
    }


    if (
      selected.hasOwnProperty(
        selectedClass
      )
    ) {

      selected[
        selectedClass
      ]++;
    }


    if (
      fallbackUsed ===
        'YES' &&
      fallbackFrom
        .hasOwnProperty(
          preferredClass
        )
    ) {

      fallbackFrom[
        preferredClass
      ]++;
    }


    if (
      noReplacementFlag ===
        'YES'
    ) {

      noReplacement++;
    }
  }


  var successful =
    selected.GREEN +
    selected.NEUTRAL +
    selected.YELLOW;


  var actualGreenPercent =
    successful > 0
      ? selected.GREEN /
        successful
      : 0;


  var actualNeutralPercent =
    successful > 0
      ? selected.NEUTRAL /
        successful
      : 0;


  var actualYellowPercent =
    successful > 0
      ? selected.YELLOW /
        successful
      : 0;


  return [

    [
      'AUDIT SUMMARY',
      'GREEN',
      'NEUTRAL',
      'YELLOW',
      'TOTAL'
    ],

    [
      'Preferred among available classes',
      preferred.GREEN,
      preferred.NEUTRAL,
      preferred.YELLOW,
      (
        preferred.GREEN +
        preferred.NEUTRAL +
        preferred.YELLOW
      )
    ],

    [
      'Actually selected',
      selected.GREEN,
      selected.NEUTRAL,
      selected.YELLOW,
      successful
    ],

    [
      'Fallback from preferred class',
      fallbackFrom.GREEN,
      fallbackFrom.NEUTRAL,
      fallbackFrom.YELLOW,
      (
        fallbackFrom.GREEN +
        fallbackFrom.NEUTRAL +
        fallbackFrom.YELLOW
      )
    ],

    [
      'No replacement found',
      '',
      '',
      '',
      noReplacement
    ],

    [
      'Target %',
      0.50,
      0.30,
      0.20,
      ''
    ],

    [
      'Actually selected %',
      actualGreenPercent,
      actualNeutralPercent,
      actualYellowPercent,
      ''
    ]
  ];
}


// =========================================================
// LANGUAGE
// =========================================================

function findLanguageByMarkers(
  name
) {

  if (
    !name
  ) {

    return null;
  }


  var normalizedName =
    name
      .toString()
      .toUpperCase();


  for (
    var i = 0;
    i < LANGUAGE_ORDER.length;
    i++
  ) {

    var code =
      LANGUAGE_ORDER[i];


    var languageConfig =
      LANGUAGES[
        code
      ];


    if (
      !languageConfig ||
      !languageConfig.markers
    ) {

      continue;
    }


    for (
      var m = 0;
      m < languageConfig.markers.length;
      m++
    ) {

      var markerCore =
        languageConfig
          .markers[m]
          .toString()
          .toUpperCase()
          .replace(
            /[^A-Z0-9А-ЯЁ\u0600-\u06FF]/g,
            ''
          );


      if (
        !markerCore
      ) {

        continue;
      }


      var markerRegex =
        new RegExp(

          '(^|[^A-Z0-9А-ЯЁ\\u0600-\\u06FF])' +

          escapeRegExp(
            markerCore
          ) +

          '($|[^A-Z0-9А-ЯЁ\\u0600-\\u06FF])'
        );


      if (
        markerRegex.test(
          normalizedName
        )
      ) {

        return code;
      }
    }
  }


  return null;
}


// =========================================================
// COLOR HELPERS
// =========================================================

function normalizeBackgroundColor(
  backgroundColor
) {

  if (
    !backgroundColor
  ) {

    return '';
  }


  return backgroundColor
    .toString()
    .trim()
    .toLowerCase();
}


function getPerformanceColorClass(
  backgroundColor
) {

  var normalized =
    normalizeBackgroundColor(
      backgroundColor
    );


  if (
    normalized ===
    LOW_PERFORMANCE_COLOR
      .toLowerCase()
  ) {

    return 'RED';
  }


  if (
    normalized ===
    BEST_PERFORMANCE_COLOR
      .toLowerCase()
  ) {

    return 'GREEN';
  }


  if (
    normalized ===
    MIXED_PERFORMANCE_COLOR
      .toLowerCase()
  ) {

    return 'YELLOW';
  }


  return 'NEUTRAL';
}


// =========================================================
// NORMALIZATION
// =========================================================

function normalizeThemeKey(
  theme
) {

  if (
    !theme
  ) {

    return DEFAULT_THEME
      .toUpperCase();
  }


  return theme
    .toString()
    .trim()
    .replace(
      /\s+/g,
      ' '
    )
    .toUpperCase();
}


function normalizeComparableText(
  text
) {

  if (
    !text
  ) {

    return '';
  }


  return text
    .toString()

    .replace(
      /\u00A0/g,
      ' '
    )

    .replace(
      /[\u200E\u200F\u061C]/g,
      ''
    )

    .replace(
      /[“”]/g,
      '"'
    )

    .replace(
      /[‘’]/g,
      "'"
    )

    .replace(
      /\r?\n|\r/g,
      ' '
    )

    .replace(
      /\s+/g,
      ' '
    )

    .trim()

    .toLowerCase();
}


function escapeRegExp(
  text
) {

  return text.replace(
    /[.*+?^${}()|[\]\\]/g,
    '\\$&'
  );
}


// =========================================================
// EDITOR SOURCE
// =========================================================

function refreshEditorSource(
  spreadsheet
) {

  var sheet =
    spreadsheet.getSheetByName(
      TAB_EDITOR_SOURCE
    );


  if (
    !sheet
  ) {

    sheet =
      spreadsheet.insertSheet(
        TAB_EDITOR_SOURCE
      );
  }


  sheet.clearContents();


  var headers = [
    'Campaign',
    'Ad Group',
    'Ad ID',
    'Status',
    'Headline 1',
    'Headline 2',
    'Headline 3',
    'Headline 4',
    'Headline 5',
    'Description 1',
    'Description 2',
    'Description 3',
    'Description 4',
    'Description 5'
  ];


  var output = [
    headers
  ];


  var query =
    "SELECT " +
    "campaign.name, " +
    "ad_group.name, " +
    "ad_group_ad.ad.id, " +
    "ad_group_ad.status, " +
    "ad_group_ad.ad.app_ad.headlines, " +
    "ad_group_ad.ad.app_ad.descriptions " +

    "FROM ad_group_ad " +

    "WHERE " +
    "campaign.status = 'ENABLED' " +
    "AND ad_group.status = 'ENABLED' " +
    "AND ad_group_ad.status != 'REMOVED' " +
    "AND ad_group_ad.ad.type = 'APP_AD'";


  var report =
    AdsApp.search(
      query
    );


  while (
    report.hasNext()
  ) {

    var row =
      report.next();


    var appAd =
      row
        .adGroupAd
        .ad
        .appAd;


    var headlines =
      extractEditorTextAssets(
        appAd
          ? appAd.headlines
          : []
      );


    var descriptions =
      extractEditorTextAssets(
        appAd
          ? appAd.descriptions
          : []
      );


    output.push([

      row.campaign.name,

      row.adGroup.name,

      String(
        row
          .adGroupAd
          .ad
          .id ||
        ''
      ),

      String(
        row
          .adGroupAd
          .status ||
        ''
      ),

      getEditorArrayValue(
        headlines,
        0
      ),

      getEditorArrayValue(
        headlines,
        1
      ),

      getEditorArrayValue(
        headlines,
        2
      ),

      getEditorArrayValue(
        headlines,
        3
      ),

      getEditorArrayValue(
        headlines,
        4
      ),

      getEditorArrayValue(
        descriptions,
        0
      ),

      getEditorArrayValue(
        descriptions,
        1
      ),

      getEditorArrayValue(
        descriptions,
        2
      ),

      getEditorArrayValue(
        descriptions,
        3
      ),

      getEditorArrayValue(
        descriptions,
        4
      )
    ]);
  }


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(
      output
    );


  sheet.setFrozenRows(
    1
  );


  if (
    !sheet.isSheetHidden()
  ) {

    sheet.hideSheet();
  }


  Logger.log(
    'EditorSource обновлён. Ads=' +
    (
      output.length -
      1
    )
  );
}


// =========================================================
// EDITOR HELPERS
// =========================================================

function extractEditorTextAssets(
  assets
) {

  var result = [];


  if (
    !assets
  ) {

    return result;
  }


  for (
    var i = 0;
    i < assets.length;
    i++
  ) {

    var item =
      assets[i];


    if (
      item &&
      item.text !== undefined &&
      item.text !== null
    ) {

      result.push(
        String(
          item.text
        )
      );
    }
  }


  return result;
}


function getEditorArrayValue(
  array,
  index
) {

  if (
    !array ||
    index < 0 ||
    index >= array.length
  ) {

    return '';
  }


  return (
    array[index] ||
    ''
  );
}
