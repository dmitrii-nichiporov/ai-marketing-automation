function deepCopy_(o) { return o === undefined ? undefined : JSON.parse(JSON.stringify(o)); }

/* ==========================================================================
   GRAPH API: РЕТРАИ, ТРОТТЛИНГ, ПАГИНАЦИЯ
   ========================================================================== */

function fbGet_(path, params)  { return fbCall_('get',  path, params, null); }
function fbPost_(path, payload) { return fbCall_('post', path, null, payload); }

function fbCall_(method, path, params, payload) {
  const s = getSettings_();
  let url = 'https://graph.facebook.com/' + s.apiVer + '/' + String(path).replace(/^\//, '');
  if (params) url += '?' + toQuery_(params);

  const opts = {
    method: method,
    muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + s.token }   // токен не светится в URL
  };
  if (payload) opts.payload = flattenPayload_(payload);

  return fbRequest_(url, opts, method + ' ' + path);
}

/** Коды, означающие исчерпание лимита. Ждать секундами бесполезно — нужен перерыв. */
const RATE_LIMIT_CODES = [4, 17, 32, 613, 80000, 80001, 80002, 80003, 80004];
/** Временные сбои — их как раз имеет смысл повторить быстро. */
const TRANSIENT_CODES = [1, 2, 341];

function fbRequest_(url, opts, label) {
  let delay = 3000;

  for (let attempt = 1; attempt <= 5; attempt++) {
    const resp = UrlFetchApp.fetch(url, opts);
    const code = resp.getResponseCode();
    const text = resp.getContentText();

    let json = {};
    try { json = JSON.parse(text); } catch (e) { /* not json */ }

    if (code >= 200 && code < 300) {
      throttleGuard_(resp, label);
      return json;
    }

    const err = json.error || {};
    const eCode = Number(err.code);
    const eSub  = Number(err.error_subcode);
    const isRate = RATE_LIMIT_CODES.indexOf(eCode) >= 0 || eSub === 2446079;
    const isTransient = code >= 500 || TRANSIENT_CODES.indexOf(eCode) >= 0;

    // рейт-лимит сбрасывается минутами, долбиться пять раз смысла нет
    const maxAttempts = isRate ? 2 : 5;

    if ((!isRate && !isTransient) || attempt >= maxAttempts) {
      const e = new Error('Meta API ' + code + ' [' + label + ']: ' +
        (err.message || text.slice(0, 500)) +
        (err.error_user_msg ? ' || ' + err.error_user_msg : '') +
        (err.error_subcode ? ' (subcode ' + err.error_subcode + ')' : ''));
      if (isRate) e.rateLimited = true;
      throw e;
    }

    Utilities.sleep(isRate ? 20000 : delay);
    delay = Math.min(delay * 2, 60000);
  }
}

/** Притормаживаем, если Meta пишет, что мы близко к лимиту. */
function throttleGuard_(resp, label) {
  const h = resp.getAllHeaders();

  // 1) бакет ads_management: call_count / cputime / total_time
  try {
    const raw = h['x-business-use-case-usage'] || h['X-Business-Use-Case-Usage'];
    if (raw) {
      const parsed = JSON.parse(raw);
      let worst = 0, detail = '', blocked = 0;
      Object.keys(parsed).forEach(function (k) {
        (parsed[k] || []).forEach(function (u) {
          const cc = u.call_count || 0, cpu = u.total_cputime || 0, tt = u.total_time || 0;
          const m = Math.max(cc, cpu, tt);
          if (m > worst) {
            worst = m;
            detail = (u.type || 'unknown') + ' calls=' + cc + '% cpu=' + cpu + '% time=' + tt + '%';
          }
          if (u.estimated_time_to_regain_access) {
            blocked = Math.max(blocked, u.estimated_time_to_regain_access);
          }
        });
      });
      if (worst > _peakUsage) { _peakUsage = worst; _usageDetail = detail; }
      if (blocked) {
        logRow_('WARN', '', 'Meta ограничила доступ, восстановление через ' + blocked + ' мин');
        worst = 100;
      }
      if (worst >= 90)      Utilities.sleep(30000);
      else if (worst >= 75) Utilities.sleep(8000);
    }
  } catch (e) { /* заголовка нет — ок */ }

  // 2) лимит самого рекламного аккаунта — именно он даёт subcode 2446079
  try {
    const rawAcct = h['x-ad-account-usage'] || h['X-Ad-Account-Usage'];
    if (rawAcct) {
      const a = JSON.parse(rawAcct);
      const util = Number(a.acc_id_util_pct || 0);
      _acctUtil = Math.max(_acctUtil, util);
      if (a.ads_api_access_tier) _apiTier = a.ads_api_access_tier;
      if (a.reset_time_duration) _acctReset = a.reset_time_duration;
      if (util >= 90)      Utilities.sleep(30000);
      else if (util >= 75) Utilities.sleep(8000);
    }
  } catch (e) { /* нет заголовка */ }

  // 3) лимит приложения
  try {
    const rawApp = h['x-app-usage'] || h['X-App-Usage'];
    if (rawApp) {
      const ap = JSON.parse(rawApp);
      _appUtil = Math.max(_appUtil,
        Number(ap.call_count || 0), Number(ap.total_cputime || 0), Number(ap.total_time || 0));
    }
  } catch (e) { /* нет заголовка */ }
}

/** Пагинация по edge. */
function fbGetAll_(path, params, hardLimit) {
  const out = [];
  const s = getSettings_();
  let res = fbGet_(path, Object.assign({ limit: 200 }, params || {}));

  while (true) {
    (res.data || []).forEach(function (x) { out.push(x); });
    if (hardLimit && out.length >= hardLimit) break;
    const next = res.paging && res.paging.next;
    if (!next) break;
    res = fbRequest_(next, {
      method: 'get', muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + s.token }
    }, 'GET next(' + path + ')');
  }
  return out;
}

function flattenPayload_(obj) {
  const out = {};
  Object.keys(obj).forEach(function (k) {
    const v = obj[k];
    if (v === undefined || v === null || v === '') return;
    out[k] = (typeof v === 'object') ? JSON.stringify(v) : String(v);
  });
  return out;
}

function toQuery_(obj) {
  return Object.keys(obj)
    .filter(function (k) { return obj[k] !== undefined && obj[k] !== null && obj[k] !== ''; })
    .map(function (k) {
      const v = (typeof obj[k] === 'object') ? JSON.stringify(obj[k]) : obj[k];
      return encodeURIComponent(k) + '=' + encodeURIComponent(v);
    }).join('&');
}

