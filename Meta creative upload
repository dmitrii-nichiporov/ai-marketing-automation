/**
 * Диагностика ассетов созданного объявления: по ad_id достаёт все video_id и
 * image_hash из креатива и проверяет каждый — готово ли транскодирование,
 * сгенерированы ли превью, доступен ли ассет в аккаунте.
 *
 * Нужна при ошибке доставки "Image Not Found (#2446386)": показывает, у какого
 * именно ролика нет превью, вместо того чтобы гадать по интерфейсу.
 */
function checkAdAssets() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('Проверка ассетов объявления',
    'ad_id (можно несколько через запятую):', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;

  const adIds = r.getResponseText().split(/[,\s]+/).map(function (x) { return x.trim(); }).filter(String);
  if (!adIds.length) return;

  const HEAD = ['ad_id', 'ad_name', 'asset', 'id / hash', 'ratio',
                'video_status', 'thumbnails', 'preferred', 'ВЕРДИКТ'];
  const sh = ensureSheet_('ad_check', [], [HEAD]);
  sh.clear();
  const rows = [HEAD];
  let problems = 0;

  adIds.forEach(function (adId) {
    let ad, creative;
    try {
      ad = fbGet_(adId, { fields: 'id,name,creative{id}' });
      creative = fbGet_(ad.creative.id, {
        fields: 'id,object_story_spec,asset_feed_spec'
      });
    } catch (e) {
      rows.push([adId, '', 'ОШИБКА', String(e.message || e).slice(0, 300), '', '', '', '', 'НЕ ПРОЧИТАН']);
      problems++;
      return;
    }

    const afs = creative.asset_feed_spec || {};
    const oss = creative.object_story_spec || {};

    // собираем все видео и картинки из обеих веток
    const videoIds = (afs.videos || []).map(function (v) { return v.video_id; });
    if (oss.video_data && oss.video_data.video_id) videoIds.push(oss.video_data.video_id);

    const hashes = (afs.images || []).map(function (im) { return im.hash; });
    if (oss.link_data && oss.link_data.image_hash) hashes.push(oss.link_data.image_hash);

    if (!videoIds.length && !hashes.length) {
      rows.push([adId, ad.name || '', '—', 'ассетов не найдено', '', '', '', '', 'ПУСТО']);
      problems++;
      return;
    }

    videoIds.filter(function (v, i) { return v && videoIds.indexOf(v) === i; }).forEach(function (vid) {
      let status = '?', thumbs = '?', preferred = '?', ratio = '', verdict = 'OK';
      try {
        const v = fbGet_(vid, { fields: 'id,title,status,format' });
        status = (v.status && v.status.video_status) || 'ready';

        let w = 0, h = 0;
        (v.format || []).forEach(function (f) {
          if ((f.width || 0) * (f.height || 0) > w * h) { w = f.width; h = f.height; }
        });
        ratio = ratioKey_(w, h) || '';

        const th = fbGetAll_(vid + '/thumbnails', { fields: 'id,uri,is_preferred' }, 50);
        thumbs = th.length;
        preferred = th.some(function (t) { return t.is_preferred; }) ? 'да' : 'НЕТ';

        if (status !== 'ready') verdict = 'ВИДЕО НЕ ГОТОВО (' + status + ')';
        else if (!th.length)    verdict = 'НЕТ ПРЕВЬЮ — вероятная причина Image Not Found';
        else if (preferred === 'НЕТ') verdict = 'есть превью, но нет preferred';
      } catch (e) {
        verdict = 'НЕДОСТУПНО: ' + String(e.message || e).slice(0, 200);
      }
      if (verdict !== 'OK') problems++;
      rows.push([adId, ad.name || '', 'video', vid, ratio, status, thumbs, preferred, verdict]);
    });

    hashes.filter(function (h, i) { return h && hashes.indexOf(h) === i; }).forEach(function (hash) {
      let ratio = '', verdict = 'OK', found = '';
      try {
        const res = fbGet_(getSettings_().actId + '/adimages', {
          fields: 'hash,name,width,height',
          hashes: JSON.stringify([hash])
        });
        const im = (res.data || [])[0];
        if (!im) {
          verdict = 'КАРТИНКИ НЕТ В АККАУНТЕ — вероятная причина Image Not Found';
        } else {
          ratio = ratioKey_(im.width, im.height) || '';
          found = im.name || '';
        }
      } catch (e) {
        verdict = 'НЕДОСТУПНО: ' + String(e.message || e).slice(0, 200);
      }
      if (verdict !== 'OK') problems++;
      rows.push([adId, ad.name || '', 'image', hash, ratio, found, '', '', verdict]);
    });
  });

  sh.getRange(1, 1, rows.length, HEAD.length).setValues(rows);
  sh.getRange(1, 1, 1, HEAD.length).setFontWeight('bold');
  SS.setActiveSheet(sh);

  ui.alert('Проверено объявлений: ' + adIds.length +
    '\nАссетов в отчёте: ' + (rows.length - 1) +
    '\nПроблемных: ' + problems +
    (problems ? '\n\nСмотри колонку ВЕРДИКТ в листе ad_check.' : '\n\nВсе ассеты в порядке.'));
}

/**
 * Выгружает сырой asset_feed_spec эталона в лист tpl_dump — чтобы глазами
 * увидеть реальную структуру bodies/titles/rules, а не гадать по интерфейсу.
 */
function dumpTemplateSpec() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('Разбор эталона', 'template_ad_id (ID объявления-эталона):', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;

  const tpl = getTemplate_(r.getResponseText().trim());
  const afs = tpl.creative.asset_feed_spec;
  const sh = ensureSheet_('tpl_dump', [], [['block', 'index', 'text / video_id', 'adlabels', 'referenced_by_rules']]);
  sh.clear();

  // какие метки реально используются правилами
  const usedByRules = {};
  (function scan(n){
    if (!n || typeof n !== 'object') return;
    if (Array.isArray(n)) return n.forEach(scan);
    Object.keys(n).forEach(function(k){
      const v = n[k];
      if (/_label$/.test(k) && v && typeof v==='object' && !Array.isArray(v)) {
        if (v.name) usedByRules[v.name] = true;
        if (v.id) usedByRules['#id:'+v.id] = true;
      } else scan(v);
    });
  })(afs && afs.asset_customization_rules);

  const rows = [['block', 'index', 'text / video_id', 'adlabels', 'referenced_by_rules']];
  const labelUsed = function(labels){
    return (labels||[]).some(function(l){ return usedByRules[l.name] || usedByRules['#id:'+l.id]; }) ? 'YES' : 'no';
  };

  ['bodies','titles','descriptions','link_urls','call_to_action_types','videos_labels'].forEach(function(key){
    (afs[key] || []).forEach(function(item, i){
      let val;
      if (typeof item !== 'object' || item === null) {
        val = String(item);
      } else {
        // показываем все поля кроме adlabels — иначе теряем url, deeplink и прочее
        val = Object.keys(item).filter(function(k){ return k !== 'adlabels'; })
          .map(function(k){
            const v = item[k];
            return k + '=' + (typeof v === 'object' ? JSON.stringify(v) : String(v));
          }).join('  |  ');
      }
      const labels = (item.adlabels || []).map(function(l){ return l.name + (l.id ? ' #'+l.id : ''); }).join(' ; ');
      rows.push([key, i+1, String(val).slice(0,500), labels, labelUsed(item.adlabels)]);
    });
  });

  (afs.videos || []).forEach(function(v, i){
    const labels = (v.adlabels || []).map(function(l){ return l.name + (l.id ? ' #'+l.id : ''); }).join(' ; ');
    rows.push(['videos', i+1, v.video_id + (v.thumbnail_url ? ' [+thumb]' : ''), labels, labelUsed(v.adlabels)]);
  });

  (afs.images || []).forEach(function(im, i){
    const labels = (im.adlabels || []).map(function(l){ return l.name + (l.id ? ' #'+l.id : ''); }).join(' ; ');
    const extra = Object.keys(im).filter(function(k){ return ['hash','adlabels'].indexOf(k) < 0; })
      .map(function(k){ return k + '=' + JSON.stringify(im[k]).slice(0, 60); }).join(' ');
    rows.push(['images', i+1, (im.hash || '?') + (extra ? '  {' + extra + '}' : ''), labels, labelUsed(im.adlabels)]);
  });

  // поля уровня креатива: именно тут живут ссылки на стор и трекинг
  rows.push(['—', '', '— поля креатива —', '', '']);
  Object.keys(tpl.creative).forEach(function (k) {
    if (k === 'asset_feed_spec' || k === 'object_story_spec') return;   // выведены выше
    const v = tpl.creative[k];
    if (v === undefined || v === null) return;
    rows.push(['creative.' + k, '', String(typeof v === 'object' ? JSON.stringify(v) : v).slice(0, 500), '', '']);
  });
  const oss = tpl.creative.object_story_spec || {};
  Object.keys(oss).forEach(function (k) {
    const v = oss[k];
    rows.push(['story_spec.' + k, '', String(typeof v === 'object' ? JSON.stringify(v) : v).slice(0, 500), '', '']);
  });
  rows.push(['—', '', '— поля объявления —', '', '']);
  Object.keys(tpl.ad).forEach(function (k) {
    if (k === 'creative') return;
    const v = tpl.ad[k];
    if (v === undefined || v === null) return;
    rows.push(['ad.' + k, '', String(typeof v === 'object' ? JSON.stringify(v) : v).slice(0, 500), '', '']);
  });

  rows.push(['rules', '', String((afs.asset_customization_rules || []).length) + ' шт', '', '']);
  (afs.asset_customization_rules || []).forEach(function(rule, i){
    const spec = JSON.stringify(rule.customization_spec || {});
    const refs = Object.keys(rule).filter(function(k){ return /_label$/.test(k); })
      .map(function(k){ return k + '=' + JSON.stringify(rule[k]); }).join(' ; ');
    rows.push(['rule', i+1, spec.slice(0,300), refs.slice(0,400), '']);
  });

  // Graph отдаёт ТОЛЬКО запрошенные поля, поэтому спрашиваем у него самого,
  // какие поля вообще есть у объекта: ?metadata=1 -> metadata.fields[].
  // Так находятся поля, о существовании которых мы не знали (например CPP).
  rows.push(['—', '', '— поля, доступные в API —', '', '']);
  [['creative', tpl.creative.id], ['ad', tpl.ad.id]].forEach(function (pair) {
    try {
      // ВАЖНО: без параметра fields — иначе Graph отдаёт только его и не строит metadata
      const meta = fbGet_(pair[1], { metadata: 1 });
      const fields = ((meta.metadata || {}).fields || []).map(function (f) { return f.name; });

      if (!fields.length) {
        // не получилось — показываем сырой ответ, чтобы было видно, что пришло
        rows.push([pair[0] + '.__raw_metadata', '', JSON.stringify(meta).slice(0, 5000), '', '']);
        return;
      }

      // список длинный — режем на строки по 400 символов, иначе не влезет в ячейку
      const joined = fields.join(', ');
      for (let off = 0, i = 1; off < joined.length; off += 400, i++) {
        rows.push([pair[0] + '.__all_fields', i, joined.substr(off, 400), '', '']);
      }

      const hot = fields.filter(function (n) {
        return /product|page|store|listing|cpp|deep|link|destination|app/i.test(n);
      });
      rows.push([pair[0] + '.__candidates', '', hot.join(', ').slice(0, 2000), '', 'СМОТРЕТЬ СЮДА']);
    } catch (e) {
      rows.push([pair[0] + '.__all_fields', '', 'не удалось: ' + (e.message || e), '', '']);
    }
  });

  sh.getRange(1, 1, rows.length, 5).setValues(rows);
  sh.getRange(1, 1, 1, 5).setFontWeight('bold');
  SS.setActiveSheet(sh);
  // какие типы ссылок используют правила — видео, картинки или и то и другое
  const refTypes = {};
  (afs.asset_customization_rules || []).forEach(function (rule) {
    Object.keys(rule).forEach(function (k) {
      if (/_label$/.test(k)) refTypes[k] = (refTypes[k] || 0) + 1;
    });
  });

  ui.alert('Готово. Лист tpl_dump: videos=' + ((afs.videos||[]).length) +
    ', images=' + ((afs.images||[]).length) +
    ', bodies=' + ((afs.bodies||[]).length) +
    ', titles=' + ((afs.titles||[]).length) +
    ', rules=' + ((afs.asset_customization_rules||[]).length) +
    '\n\nСсылки в правилах: ' + Object.keys(refTypes).map(function (k) {
      return k + '×' + refTypes[k];
    }).join(', '));
}

