/**
 * Инкрементальная синхронизация листа media_cache с медиатекой аккаунта.
 *
 * /advideos отдаёт записи от свежих к старым, а старые не меняются — значит
 * достаточно идти сверху и остановиться на первом уже известном video_id.
 * Обычно это один запрос вместо четырёх; объём работы пропорционален числу
 * новых креативов, а не размеру медиатеки.
 *
 * fullRebuild = true — полная пересборка листа с нуля (btn_rebuildMedia).
 */
function syncMediaCache_(fullRebuild) {
  const s = getSettings_();
  const sh = ensureSheet_(SHEETS.MEDIA, [], [['video_id', 'title', 'created_time']]);

  const known = {};
  let cached = [];

  if (fullRebuild) {
    if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, 3).clearContent();
  } else if (sh.getLastRow() > 1) {
    cached = sh.getRange(2, 1, sh.getLastRow() - 1, 3).getValues()
      .filter(function (r) { return String(r[0] || '').trim(); })
      .map(function (r) { return [String(r[0]).trim(), String(r[1] || ''), String(r[2] || '')]; });
    cached.forEach(function (r) { known[r[0]] = true; });
  }

  const fresh = [];
  let scanned = 0, reachedKnown = false;
  let res = fbGet_(s.actId + '/advideos', { fields: 'id,title,created_time', limit: 200 });

  while (true) {
    const data = res.data || [];
    for (let i = 0; i < data.length; i++) {
      scanned++;
      const v = data[i];
      if (known[String(v.id)]) { reachedKnown = true; break; }
      fresh.push([String(v.id), String(v.title || ''), String(v.created_time || '')]);
    }
    if (reachedKnown) break;
    if (!fullRebuild && scanned >= s.assetLimit) break;   // потолок только для инкремента; rebuild берёт всё
    const next = res.paging && res.paging.next;
    if (!next) break;
    res = fbRequest_(next, {
      method: 'get', muteHttpExceptions: true,
      headers: { Authorization: 'Bearer ' + s.token }
    }, 'GET next(advideos)');
  }

  if (fresh.length) {
    sh.insertRowsAfter(1, fresh.length);         // новые — сверху, порядок сохраняется
    sh.getRange(2, 1, fresh.length, 3).setValues(fresh);
    logRow_('INFO', '', 'media_cache: +' + fresh.length + ' новых видео, просканировано ' +
      scanned + ', в кэше стало ' + (fresh.length + cached.length));
  }

  return fresh.concat(cached).map(function (r) {
    return { id: r[0], title: r[1], created_time: r[2] };
  });
}

/** Кэш картинок аккаунта. /adimages не гарантирует порядок, поэтому читаем целиком. */
let _imageList = null;

function getImageList_() {
  if (_imageList) return _imageList;
  const s = getSettings_();
  const sh = ensureSheet_(SHEETS.MEDIA_IMG, [], [['hash', 'name', 'width', 'height', 'created_time']]);

  const list = fbGetAll_(s.actId + '/adimages',
    { fields: 'hash,name,filename,width,height,created_time' }, s.assetLimit);

  const rows = list.map(function (im) {
