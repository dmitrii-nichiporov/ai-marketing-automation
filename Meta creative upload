/** Показывает, какому приложению принадлежит токен, какие у него права и срок. */
function showTokenInfo() {
  const s = getSettings_();
  const r = fbGet_('debug_token', { input_token: s.token });
  const d = r.data || {};
  const exp = d.expires_at
    ? new Date(d.expires_at * 1000).toLocaleString()
    : 'бессрочный';
  const msg = [
    'app_id:       ' + (d.app_id || '?'),
    'приложение:   ' + (d.application || '?'),
    'тип токена:   ' + (d.type || '?'),
    'валиден:      ' + (d.is_valid ? 'да' : 'НЕТ'),
    'истекает:     ' + exp,
    '',
    'права: ' + ((d.scopes || []).join(', ') || '—')
  ].join('\n');
  logRow_('INFO', '', 'Токен: app_id=' + (d.app_id || '?') + ', app=' + (d.application || '?'));
  SpreadsheetApp.getUi().alert('Информация о токене', msg, SpreadsheetApp.getUi().ButtonSet.OK);
}

