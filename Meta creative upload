/* ---------- settings ---------- */

function getSettings_() {
  if (_settingsCache) return _settingsCache;

  const sh = SS.getSheetByName(SHEETS.SETTINGS);
  if (!sh) throw new Error('Нет листа "' + SHEETS.SETTINGS + '". Запусти "Создать листы".');

  const kv = {};
  sh.getDataRange().getValues().forEach(function (r) {
    const k = String(r[0] || '').trim();
    if (k) kv[k] = r[1];
  });

  const token = PropertiesService.getScriptProperties().getProperty('FB_TOKEN')
             || String(kv['access_token'] || '').trim();
  if (!token) throw new Error('Нет токена. Меню → "Сохранить токен".');

  _settingsCache = {
    token:        token,
    actId:        normalizeActId_(kv['ad_account_id']),
    apiVer:       String(kv['api_version'] || DEFAULTS.API_VER).trim(),
    adStatus:     String(kv['new_ad_status'] || DEFAULTS.AD_STATUS).trim().toUpperCase(),
    dryRun:       isTrue_(kv['dry_run']),
    assetLimit:   Number(kv['assets_lookup_limit'] || DEFAULTS.ASSET_LOOKUP_LIMIT),
    copyTracking: isTrue_(kv['copy_tracking_specs']),
    fallbackRatio: String(kv['fallback_ratio'] || '1:1').trim(),
    defaultLang:   String(kv['default_language'] || 'EN').trim().toUpperCase(),
    maxAdsPerRun:  Number(kv['max_ads_per_run'] || 200),
    writePauseMs:  Number(kv['pause_between_ads_ms'] || 0),
    adsetStatuses: String(kv['adset_statuses'] || 'ACTIVE')
                     .toUpperCase().split(',').map(function (x) { return x.trim(); }).filter(String)
  };
  return _settingsCache;
}

function normalizeActId_(v) {
  const s = String(v || '').trim();
  if (!s) throw new Error('Не задан ad_account_id в листе settings');
  return s.indexOf('act_') === 0 ? s : 'act_' + s.replace(/\D/g, '');
}

function isTrue_(v) {
  return String(v).trim().toLowerCase() === 'true' || v === true;
}

function saveToken() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('Meta access token',
    'Вставь long-lived токен (лучше system user, права ads_management):', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  PropertiesService.getScriptProperties().setProperty('FB_TOKEN', r.getResponseText().trim());
  ui.alert('Токен сохранён в Script Properties (в таблице не лежит).');
}

/* ---------- чтение листов ---------- */

/** Читает лист как массив объектов по заголовкам первой строки. */
function readSheetObjects_(sheetName) {
  const sh = SS.getSheetByName(sheetName);
  if (!sh) throw new Error('Нет листа "' + sheetName + '"');
  const values = sh.getDataRange().getValues();
  if (values.length < 2) return { sheet: sh, headers: {}, rows: [] };

  const headers = {};
  values[0].forEach(function (h, i) {
    const k = String(h || '').trim().toLowerCase();
    if (k) headers[k] = i;
  });

  const rows = [];
  for (let i = 1; i < values.length; i++) {
    const raw = values[i];
    if (raw.join('').trim() === '') continue;
    rows.push({ rowIndex: i + 1, raw: raw, get: function (name) {
      const idx = headers[name];
      return idx === undefined ? '' : String(raw[idx] === null ? '' : raw[idx]).trim();
    }});
  }
  return { sheet: sh, headers: headers, rows: rows };
}

/** Карта шаблонов: "MOPS|IOS" -> ad_id */
/**
 * Карта шаблонов: "MOPS|IOS|VIDEO" -> ad_id.
 * Колонка type необязательна: пусто = VIDEO, чтобы старые листы работали как раньше.
 */
function readTemplates_() {
  const t = readSheetObjects_(SHEETS.TEMPLATES);
  const map = {};
  t.rows.forEach(function (r) {
    const title = r.get('title').toUpperCase();
    const os    = r.get('os').toUpperCase();
    const type  = (r.get('type') || 'VIDEO').toUpperCase();
    const adId  = r.get('template_ad_id');
    if (title && os && adId) map[title + '|' + os + '|' + type] = adId;
  });
  return map;
}

