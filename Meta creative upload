/* ---------- кампании ---------- */

function resolveCampaign_(raw) {
  const v = String(raw || '').trim();
  if (!v) throw new Error('Пустое название кампании');
  if (/^\d{10,}$/.test(v)) return { id: v, name: '(по ID)' };

  if (!_campaignIndex) {
    const s = getSettings_();
    _campaignIndex = fbGetAll_(s.actId + '/campaigns', {
      fields: 'id,name,effective_status,objective',
      effective_status: ['ACTIVE', 'PAUSED']
    }, 10000);
  }

  const lower = v.toLowerCase();
  let hits = _campaignIndex.filter(function (c) { return c.name.toLowerCase() === lower; });
  if (!hits.length) {
    hits = _campaignIndex.filter(function (c) { return c.name.toLowerCase().indexOf(lower) >= 0; });
  }
  if (!hits.length) throw new Error('Кампания не найдена: "' + v + '"');
  if (hits.length > 1) {
    throw new Error('Под "' + v + '" подходит ' + hits.length + ' кампаний: ' +
      hits.slice(0, 5).map(function (c) { return c.name; }).join(' | ') +
      '. Уточни название или впиши campaign_id.');
  }
  return hits[0];
}

