/**
 * Платформа определяется по promoted_object.object_store_url — это единственный
 * надёжный источник. Нейминг ad set-а — только фолбэк.
 */
function detectOs_(adset, campaignName) {
  const po = adset.promoted_object || {};
  const url = String(po.object_store_url || '');

  if (/apps\.apple\.com|itunes\.apple\.com/i.test(url)) return 'IOS';
  if (/play\.google\.com/i.test(url)) return 'ANDROID';

  if (po.pixel_id && !po.application_id) return 'WEB';

  const n = (adset.name + ' ' + (campaignName || '')).toLowerCase();
  if (/(^|[^a-z])ios([^a-z]|$)|iphone|ipad|appstore|app_store|itunes/.test(n)) return 'IOS';
  if (/android|google_?play|(^|[^a-z])gp([^a-z]|$)/.test(n)) return 'ANDROID';

  return 'UNKNOWN';
}

function filterAdsets_(adsets, filter) {
  const f = String(filter || '').trim();
  if (!f) return adsets;
  const parts = f.split(',').map(function (x) { return x.trim().toLowerCase(); }).filter(String);
  return adsets.filter(function (a) {
    return parts.some(function (p) {
      return a.id === p || a.name.toLowerCase().indexOf(p) >= 0;
    });
  });
}

/* ---------- тайтл ---------- */

function detectTitle_(explicit, campaignName, creativeId) {
  const e = String(explicit || '').trim().toUpperCase();
  if (e) return e;
  const sources = [String(creativeId || '').toUpperCase(), String(campaignName || '').toUpperCase()];
  for (let s = 0; s < sources.length; s++) {
    for (let i = 0; i < TITLES.length; i++) {
      const t = TITLES[i];
      if (new RegExp('(^|[^A-Z0-9])' + t + '([^A-Z0-9]|$)').test(sources[s])) return t;
    }
  }
  return '';
}

/* ---------- соотношения сторон ---------- */

const RATIO_TOLERANCE = 0.04;
const KNOWN_RATIOS = [
  { key: '1:1',    value: 1 },
  { key: '9:16',   value: 9 / 16 },
  { key: '16:9',   value: 16 / 9 },
  { key: '4:5',    value: 4 / 5 },
  { key: '2:3',    value: 2 / 3 },
  { key: '1.91:1', value: 1.91 }
];

function ratioKey_(w, h) {
  if (!w || !h) return null;
  const r = w / h;
  let best = null, bestDiff = Infinity;
  KNOWN_RATIOS.forEach(function (k) {
    const d = Math.abs(r - k.value) / k.value;
    if (d < bestDiff) { bestDiff = d; best = k.key; }
  });
  return bestDiff <= RATIO_TOLERANCE ? best : (Math.round(r * 100) / 100) + ':1';
}

/**
 * Язык из имени файла: MOPS-v0079_Liub_backpacks_EN_1080x1080_21sec.mp4 -> EN.
 * Основной шаблон — сегмент прямо перед разрешением, это надёжнее всего.
 * Просто искать "EN" подстрокой нельзя: найдётся внутри Interface, Gameplay и т.п.
 */
function parseLangFromName_(name) {
  const m = String(name || '').match(/[_\-\s]([A-Za-z]{2,3})[_\-\s]\d{3,4}\s*[xXхХ\u00d7]/);
  if (m) return m[1].toUpperCase();
  const parts = String(name || '').split(/[_\-\s.]+/);
  for (let i = parts.length - 1; i >= 0; i--) {
    if (/^[A-Za-z]{2,3}$/.test(parts[i])) return parts[i].toUpperCase();
  }
  return null;
}

/** Достаёт 1080x1920 из имени файла. Кириллическая "х" и "×" тоже ловятся. */
function parseRatioFromName_(name) {
  const m = String(name || '').match(/(\d{3,4})\s*[xXхХ\u00d7]\s*(\d{3,4})/);
  return m ? ratioKey_(Number(m[1]), Number(m[2])) : null;
}

